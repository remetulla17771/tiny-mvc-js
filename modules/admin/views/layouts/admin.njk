<!-- views/layouts/main.njk -->
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Layout</title>
    {{ view.renderHead() | safe }}
</head>
<body>
    <div class="wrap">
        <!-- Yii2 Style NavBar -->
        <nav class="navbar navbar-expand-md navbar-dark bg-dark fixed-top">
            <div class="container">
                <a class="navbar-brand" href="/site/index">{{ Yii.app.config.appName }} | Admin</a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#w0-collapse" aria-controls="w0-collapse" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="w0-collapse">
                    <ul class="navbar-nav ms-auto mb-2 mb-md-0">
                        <li class="nav-item">
                            <a class="nav-link active" href="/site/index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/site/about">About</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/site/contact">Contact</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/site/create">Create User</a>
                        </li>

                        {% if isGuest %}
                                <li class="nav-item">
                                    <a class="nav-link" href="/site/login">Login</a>
                                </li>
                            {% else %}
                                <li class="nav-item">
                                    <span class="nav-link" style="color: #fff;">({{ currentUser.username }})</span>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="/site/logout">Logout</a>
                                </li>
                            {% endif %}

                    </ul>
                </div>
            </div>
        </nav>

        <!-- Main Content Wrapper -->
        <main class="container" role="main">
            <!-- Flash Messages -->
            {% if flashes and flashes | length > 0 %}
                <div class="flashes-container">
                    {% for type, message in flashes %}
                        <div class="alert alert-{{ type }} alert-dismissible fade show" role="alert">
                            {{ message }}
                        </div>
                    {% endfor %}
                </div>
            {% endif %}

            {{ content | safe }}
        </main>
    </div>

    <!-- Yii2 Style Footer -->
   <footer class="footer mt-auto py-3 bg-light border-top">
       <div class="container">
           <div class="row text-muted">
               <div class="col-6 text-start">&copy; My Company {{ year | default(2026) }}</div>
               <div class="col-6 text-end">Powered by <a href="https://www.yiiframework.com/" rel="external">Yii Framework (Node.js)</a></div>
           </div>
       </div>
   </footer>

    {{ view.renderEndBody() | safe }}
</body>
</html>