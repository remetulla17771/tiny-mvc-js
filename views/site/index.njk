{# views/site/index.njk #}
<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
    <h2>Список пользователей</h2>
    <a href="/site/create" class="btn-action" style="text-decoration: none;">+ Создать</a>
</div>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Имя</th>
            <th>Email</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        {% for user in users %}
            <tr>
                <td>{{ user.id }}</td>
                <td><strong>{{ user.username }}</strong></td>
                <td>{{ user.email }}</td>
                <td>
                    <a href="/site/update?id={{ user.id }}" class="btn btn-primary">Редактировать</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4" style="text-align: center; color: var(--text-muted);">Пользователи не найдены</td>
            </tr>
        {% endfor %}
    </tbody>
</table>